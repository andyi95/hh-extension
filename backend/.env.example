# Скопируйте в .env и поменяйте значения.

DATABASE_URL=sqlite://db.sqlite3

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=365
REFRESH_GRACE_SEC=120

# dev: любое расширение; prod: chrome-extension://<ID вашего расширения>
CORS_ORIGIN_REGEX=chrome-extension://.*
